# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับ environment ของคุณ
# cp .env.example .env
#
# docker compose อ่านไฟล์ .env ไปแทนค่าตัวแปรใน docker-compose.yml ด้วย

# ── PostgreSQL (service `postgres` ใน docker-compose.yml) ───
POSTGRES_USER=esaraban
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=esaraban
POSTGRES_PORT=5432

# ── Database URL ที่ Prisma ใช้ ─────────────────────────────
# host = localhost สำหรับรันบนเครื่อง (ต่อเข้า container ผ่าน POSTGRES_PORT)
# ค่านี้ต้องตรงกับ POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB ข้างบน
# ⚠️ service `app` และ `migrate` ในโหมด prod ไม่ได้ใช้ค่านี้ — compose ประกอบ URL
#    ที่ชี้ host = postgres ให้เอง จากตัวแปร POSTGRES_* ข้างบน
DATABASE_URL="postgresql://esaraban:CHANGE_ME@localhost:5432/esaraban?schema=public"

# ── ที่เก็บไฟล์แนบ (spec §8.2 · D18) ────────────────────────
# โฟลเดอร์ที่ LocalFsStorage เขียนไฟล์ลง — ต้องอยู่ **นอก** public/ เสมอ
# ปล่อยว่างได้ ค่าปริยายคือ ./storage/attachments
# ใน docker compose โหมด prod ผูกกับ volume `file-storage` ที่ /app/storage อยู่แล้ว
STORAGE_ROOT=

# ── Encryption (spec §8.2) ──────────────────────────────────
# Master Key (KEK) สำหรับ envelope encryption ของไฟล์แนบ
# สร้างด้วย: openssl rand -base64 32
# ⚠️ ห้ามเก็บใน database หรือ git เด็ดขาด
#
# รับสองรูปแบบ:
#   FILE_MASTER_KEY="<base64>"              → กุญแจรุ่นที่ 1 (ใช้ตอนติดตั้งครั้งแรก)
#   FILE_MASTER_KEY="2:<base64>,1:<base64>" → หลายรุ่น · รุ่นสูงสุดใช้เข้ารหัสของใหม่
#
# ตอนหมุนกุญแจ (rotate): เติมรุ่นใหม่ไว้หน้ารุ่นเดิม แล้ว **เก็บรุ่นเดิมไว้**
# จนกว่าจะไล่ re-wrap ไฟล์เก่าครบ ไม่งั้นไฟล์ที่ยังผูกกับรุ่นเดิมจะถอดไม่ออกถาวร
FILE_MASTER_KEY=""

# ── Session / JWT (spec §8.4) ───────────────────────────────
# สร้างด้วย: openssl rand -base64 32
# จะใช้จริงตั้งแต่ P1
AUTH_SECRET=""

# ── nginx (ใช้เฉพาะ profile prod) ───────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# ── Google Sign-In (spec §17.3 · D19) ───────────────────────
# สร้างที่ Google Cloud Console → APIs & Services → Credentials
# → Create OAuth client ID → Web application
#
# Authorized redirect URIs ที่ต้องใส่ให้ครบทั้งสองแบบ:
#   http://localhost:3000/api/auth/callback/google   (ตอน dev)
#   https://<โดเมนจริง>/api/auth/callback/google      (ตอน production — ต้องเป็น https)
#
# ⚠️ ปล่อยว่างไว้ได้ — ปุ่ม "เข้าสู่ระบบด้วย Google" จะซ่อนอัตโนมัติเมื่อยังไม่ตั้งค่า
#    ตั้งใจให้เป็นแบบนี้เพื่อให้ deploy ที่อยู่ในวงปิด (ออกอินเทอร์เน็ตไม่ได้) ใช้งานได้ตามปกติ
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# โดเมน Google Workspace ที่อนุญาต (ค่า `hd` ของ Google · spec §17.3)
# ⚠️ ปล่อยว่าง = รับทุกโดเมนรวม gmail ส่วนตัว — **ห้ามปล่อยว่างบนเครื่องจริง**
GOOGLE_ALLOWED_HD="krirk.ac.th"
