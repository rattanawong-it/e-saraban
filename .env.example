# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับ environment ของคุณ
# cp .env.example .env
#
# docker compose อ่านไฟล์ .env ไปแทนค่าตัวแปรใน docker-compose.yml ด้วย

# ── PostgreSQL (service `postgres` ใน docker-compose.yml) ───
POSTGRES_USER=esaraban
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=esaraban
POSTGRES_PORT=5432

# ── Database URL ที่ Prisma ใช้ ─────────────────────────────
# host = localhost สำหรับรันบนเครื่อง (ต่อเข้า container ผ่าน POSTGRES_PORT)
# ค่านี้ต้องตรงกับ POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB ข้างบน
# ⚠️ service `app` และ `migrate` ในโหมด prod ไม่ได้ใช้ค่านี้ — compose ประกอบ URL
#    ที่ชี้ host = postgres ให้เอง จากตัวแปร POSTGRES_* ข้างบน
DATABASE_URL="postgresql://esaraban:CHANGE_ME@localhost:5432/esaraban?schema=public"

# ── ที่เก็บไฟล์แนบ (spec §8.2 · D18) ────────────────────────
# โฟลเดอร์ที่ LocalFsStorage เขียนไฟล์ลง — ต้องอยู่ **นอก** public/ เสมอ
# ปล่อยว่างได้ ค่าปริยายคือ ./storage/attachments
# ใน docker compose โหมด prod ผูกกับ volume `file-storage` ที่ /app/storage อยู่แล้ว
STORAGE_ROOT=

# ── Encryption (spec §8.2) ──────────────────────────────────
# Master Key (KEK) สำหรับ envelope encryption ของไฟล์แนบ
# สร้างด้วย: openssl rand -base64 32
# ⚠️ ห้ามเก็บใน database หรือ git เด็ดขาด — จะใช้จริงตั้งแต่ P3
FILE_MASTER_KEY=""

# ── Session / JWT (spec §8.4) ───────────────────────────────
# สร้างด้วย: openssl rand -base64 32
# จะใช้จริงตั้งแต่ P1
AUTH_SECRET=""

# ── nginx (ใช้เฉพาะ profile prod) ───────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
