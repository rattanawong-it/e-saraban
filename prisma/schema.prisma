// e-Saraban — Prisma schema
// โมเดลข้อมูลตาม spec §9
//
// ขอบเขตไฟล์นี้ตอนนี้คือ **P1 — Identity & Org**:
//   Tenant · OrgUnit · User · UserOrgUnit · Role · Permission · RolePermission ·
//   UserRole · Session · AuditLog · SystemSetting + โมเดลช่วยของ flow สมัคร/ลืมรหัสผ่าน
//
// โมเดลฝั่งเอกสาร (Document, NumberSequence, Attachment, DocumentRecipient,
// DocumentAction, DocumentAcl, Notification) จะเพิ่มใน P2/P3/P5
//
// กติกาที่ยึดตาม spec §9.3 และ §11.3 ข้อ 4:
//   - ทุกตารางหลักมี `tenantId` ตั้งแต่วันแรก
//   - FK ใช้ onDelete: Restrict ทั้งหมด (ไม่ cascade) กันข้อมูลทะเบียนหายเป็นลูกโซ่
//   - ลบเป็น soft delete ด้วย `deletedAt` / `isActive`
//   - เวลาเก็บเป็น timestamptz (UTC) แปลงเป็น Asia/Bangkok ที่ชั้น presentation

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"

  // spec §11.1 + §9.2 — pg_trgm คือกลไกค้นหาหลักสำหรับภาษาไทย (ตัดคำด้วย tsvector ไม่ได้)
  extensions = [pg_trgm, unaccent]
}

// ---------------------------------------------------------------------------
// Enum
// ---------------------------------------------------------------------------

/// ประเภทหน่วยงาน (spec §5.1) — ใช้เป็นป้ายกำกับ ไม่ได้บังคับลำดับชั้น
enum OrgUnitType {
  UNIVERSITY /// มหาวิทยาลัย / สถาบัน
  FACULTY /// คณะ
  OFFICE /// สำนัก / สำนักงาน
  DIVISION /// กอง
  DEPARTMENT /// ภาควิชา
  CENTER /// ศูนย์
  SECTION /// งาน / ฝ่าย
}

/// ขอบเขตของสิทธิ์ (spec §4.2)
enum PermissionScope {
  OWN /// ของตนเอง
  UNIT /// หน่วยงานปัจจุบัน
  SUBTREE /// หน่วยงานตนและลูกหลาน
  ORG /// ทั้งองค์กร
}

/// ผลการตัดสินสิทธิ์ที่บันทึกลง audit (spec §8.5)
enum AuditResult {
  ALLOW
  DENY
}

/// ความรุนแรงของเหตุการณ์ใน audit log (spec §8.5)
enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

/// สถานะคำขอ (ใช้ทั้งคำขอสมัครใช้งานและคำขอรีเซ็ตรหัสผ่าน)
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Tenant — เผื่ออนาคต · MVP มีแถวเดียว (spec §9.1, D1)
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid(7))
  code      String   @unique
  nameTh    String
  nameEn    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  orgUnits             OrgUnit[]
  users                User[]
  auditLogs            AuditLog[]
  settings             SystemSetting[]
  registrationRequests RegistrationRequest[]
  documentTypes        DocumentType[]
  documents            Document[]
  numberSequences      NumberSequence[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// OrgUnit — โครงสร้างลำดับชั้นไม่จำกัดระดับ (spec §5.1)
// Adjacency List (parentId) + Materialized Path (path) คู่กัน
// path เก็บรูปแบบ "/<id>/<id>/" → query subtree ด้วย path LIKE '/a/b/%'
// ---------------------------------------------------------------------------

model OrgUnit {
  id       String  @id @default(uuid(7))
  tenantId String
  parentId String?

  /// materialized path ของ **ตนเองรวมอยู่ด้วย** เช่น "/root/faculty/dept/"
  /// ลูกหลานทั้งหมดหาได้ด้วย `path LIKE '<path ของ node>%'`
  path String

  /// รหัสงานสารบรรณ 6 หลัก เช่น "510200" (spec §5.1 · D14)
  code      String
  nameTh    String
  shortName String?
  type      OrgUnitType @default(SECTION)

  /// ออกเลขหนังสือในนามหน่วยงานนี้ได้ไหม (spec D15)
  /// ระดับ 1–2 เป็น true · ระดับ "งาน" และหลักสูตรเป็น false
  /// เก็บเป็นฟิลด์ ไม่คำนวณจาก level ตอน runtime เพราะมีข้อยกเว้นที่ต้องแก้ด้วยมือ (spec §16)
  canIssueNumber Boolean @default(true)

  /// ระดับความลึก — root = 0 · เก็บซ้ำไว้เพื่อ sort/แสดงผลโดยไม่ต้องนับ path
  level      Int     @default(0)
  sortOrder  Int     @default(0)
  headUserId String?
  isActive   Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parent   OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children OrgUnit[] @relation("OrgUnitTree")
  head     User?     @relation("OrgUnitHead", fields: [headUserId], references: [id], onDelete: Restrict)

  members              UserOrgUnit[]
  userRoles            UserRole[]
  sessions             Session[]
  registrationRequests RegistrationRequest[]
  ownedDocuments       Document[]            @relation("DocumentOwnerUnit")
  createdDocuments     Document[]            @relation("DocumentCreatedByUnit")
  documentRecipients   DocumentRecipient[]
  documentActions      DocumentAction[]
  numberSequences      NumberSequence[]

  confidentialRegistrars ConfidentialRegistrar[]

  @@unique([tenantId, code])
  /// spec §9.2 — subtree query ด้วย LIKE 'path%'
  @@index([path])
  @@index([tenantId, parentId, sortOrder])
  @@map("org_units")
}

// ---------------------------------------------------------------------------
// User (spec §9.1) + สังกัดหลายหน่วยงาน (spec §5.2)
// ---------------------------------------------------------------------------

model User {
  id       String @id @default(uuid(7))
  tenantId String
  username String @unique

  /// ว่างได้ตั้งแต่ D19 — ผู้ใช้ที่เข้าด้วย Google อย่างเดียวไม่มีรหัสผ่าน (spec §17.3)
  /// ⚠️ ทุกจุดที่อ่านค่านี้ต้องเผื่อ null เสมอ ห้ามสมมติว่ามีรหัสผ่าน
  passwordHash String?

  /// ⚠️ **เก็บเป็นตัวพิมพ์เล็กเสมอ** — เป็นคีย์ที่ใช้จับคู่บัญชี Google ครั้งแรก (spec §17.3)
  /// unique ต่อ tenant · ค่า null ซ้ำกันได้ตามปกติของ Postgres (ผู้ใช้ที่ยังไม่มีอีเมล)
  email  String?
  prefix String?

  firstName String
  lastName  String

  /// ชั้นความลับสูงสุดที่เข้าถึงได้ 0–3 (spec §8.1)
  clearanceLevel Int @default(0)

  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)
  lastLoginAt        DateTime? @db.Timestamptz(3)
  passwordChangedAt  DateTime? @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  orgUnits              UserOrgUnit[]
  roles                 UserRole[]             @relation("UserRoleUser")
  grantedRoles          UserRole[]             @relation("UserRoleGrantedBy")
  sessions              Session[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  headOfUnits           OrgUnit[]              @relation("OrgUnitHead")
  updatedSettings       SystemSetting[]
  resetRequests         PasswordResetRequest[] @relation("ResetRequestUser")
  resolvedResets        PasswordResetRequest[] @relation("ResetRequestResolvedBy")
  reviewedRegistrations RegistrationRequest[]  @relation("RegistrationReviewedBy")
  createdDocuments      Document[]             @relation("DocumentCreatedBy")
  documentRecipients    DocumentRecipient[]
  documentActions       DocumentAction[]
  uploadedAttachments   Attachment[]           @relation("AttachmentUploadedBy")
  grantedDocumentAcls   DocumentAcl[]          @relation("DocumentAclGrantedBy")

  confidentialRegistrarOf        ConfidentialRegistrar[] @relation("ConfidentialRegistrarUser")
  assignedConfidentialRegistrars ConfidentialRegistrar[] @relation("ConfidentialRegistrarAssignedBy")

  identities UserIdentity[]

  @@unique([tenantId, email])
  @@index([tenantId, isActive])
  @@index([tenantId, lastName, firstName])
  @@map("users")
}

// ---------------------------------------------------------------------------
// UserIdentity (spec §17.3 · D19) — บัญชีจากผู้ให้บริการภายนอกที่ผูกกับผู้ใช้ในระบบ
//
// ทำไมเป็นตารางแยกและมีคอลัมน์ `provider` ตั้งแต่แรก แทนที่จะยัดฟิลด์ googleSub
// ลงใน User: วันที่เพิ่ม M365 หรือ LDAP จะได้ไม่ต้อง migrate ตาราง users อีกรอบ
//
// ⚠️ **จับคู่ด้วย providerAccountId (`sub` ของ Google) ไม่ใช่ด้วยอีเมล** หลังผูกครั้งแรก
// เพราะ Google Workspace เปลี่ยนชื่ออีเมลได้ และอีเมลของคนที่ลาออกถูกยกให้คนใหม่ได้ —
// ยึดอีเมลอย่างเดียวคือเปิดทางให้เข้าบัญชีผิดคน (spec §17.3)
// ---------------------------------------------------------------------------

model UserIdentity {
  id     String @id @default(uuid(7))
  userId String

  /// ผู้ให้บริการ — ตอนนี้มีค่าเดียวคือ "google" (D19 ไม่รับ LINE)
  provider String

  /// ตัวระบุถาวรของผู้ใช้ฝั่งผู้ให้บริการ — ของ Google คือ `sub` ใน id_token
  providerAccountId String

  /// อีเมลที่ผู้ให้บริการคืนมา ณ ตอนผูก — เก็บไว้เพื่อการตรวจสอบย้อนหลังเท่านั้น
  /// **ห้ามใช้ค่านี้ตัดสินสิทธิ์** เพราะอาจไม่ตรงกับ `User.email` ปัจจุบันแล้ว
  email String?

  /// โดเมน Google Workspace (`hd`) ณ ตอนผูก — ใช้ตามหลังตอนตรวจสอบ
  hostedDomain String?

  linkedAt   DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("user_identities")
}

/// สังกัดของผู้ใช้ (spec §5.2) — คนหนึ่งอยู่ได้หลายหน่วยงานพร้อมกัน
model UserOrgUnit {
  id            String    @id @default(uuid(7))
  userId        String
  orgUnitId     String
  positionTitle String?
  isPrimary     Boolean   @default(false)
  startDate     DateTime? @db.Timestamptz(3)
  endDate       DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)

  @@unique([userId, orgUnitId])
  @@index([orgUnitId])
  @@map("user_org_units")
}

// ---------------------------------------------------------------------------
// RBAC (spec §4) — Role ผูกกับคู่ (User, OrgUnit) ไม่ใช่กับ User เดี่ยว
// ---------------------------------------------------------------------------

model Role {
  id          String  @id @default(uuid(7))
  code        String  @unique
  nameTh      String
  description String?

  /// บทบาทของระบบ — ห้ามลบ แก้ได้เฉพาะชุดสิทธิ์
  isSystem  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  code   String @id
  group  String
  nameTh String

  /// คำอธิบายว่าสิทธิ์นี้ทำอะไรได้ — แสดงในหน้า /admin/roles
  description String?
  sortOrder   Int     @default(0)

  roles RolePermission[]

  @@index([group, sortOrder])
  @@map("permissions")
}

model RolePermission {
  roleId         String
  permissionCode String
  scope          PermissionScope @default(UNIT)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(uuid(7))
  userId String
  roleId String

  /// null = บทบาทระดับทั้งองค์กร (global) เช่น SYSTEM_ADMIN
  orgUnitId String?

  grantedById String?
  grantedAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime? @db.Timestamptz(3)

  user      User     @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy User?    @relation("UserRoleGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  orgUnit   OrgUnit? @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, orgUnitId])
  @@index([userId])
  @@index([orgUnitId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Session (spec §8.4) — JWT ใน cookie + ตาราง Session เพื่อให้ revoke ได้จริง
// ---------------------------------------------------------------------------

/// วิธีที่ผู้ใช้ยืนยันตัวตนของเซสชันนี้ (spec §17.3 · D19)
enum AuthMethod {
  PASSWORD
  GOOGLE
}

model Session {
  id     String @id @default(uuid(7))
  userId String

  /// ⚠️ ใช้ตัดสินว่าจะบังคับเปลี่ยนรหัสผ่านครั้งแรกหรือไม่ — คนที่เข้าด้วย Google
  /// ไม่ได้ใช้รหัสผ่านชั่วคราวนั้นอยู่แล้ว การไล่ไปหน้าเปลี่ยนรหัสผ่านที่ขอ
  /// "รหัสผ่านปัจจุบัน" จึงทำให้เขาติดอยู่ตรงนั้นออกไปไหนไม่ได้เลย
  /// ค่าในตาราง users ยังเป็น true เหมือนเดิม ถ้ากลับมาล็อกอินด้วยรหัสผ่านจะโดนบังคับตามปกติ
  authMethod AuthMethod @default(PASSWORD)

  /// หน่วยงานที่ผู้ใช้กำลังสวมบทบาทอยู่ (Context Switcher · spec §5.2)
  activeOrgUnitId String?

  ip        String?
  userAgent String?

  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  activeOrgUnit OrgUnit? @relation(fields: [activeOrgUnitId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// AuditLog (spec §8.5) — append-only + hash chain
// ห้ามมีคำสั่ง UPDATE/DELETE กับตารางนี้ในโค้ด
// ---------------------------------------------------------------------------

model AuditLog {
  id       String   @id @default(uuid(7))
  tenantId String
  at       DateTime @default(now()) @db.Timestamptz(3)

  actorUserId    String?
  actorOrgUnitId String?

  /// รหัสการกระทำ เช่น "auth.login" "orgunit.create" (ดู src/lib/audit/actions.ts)
  action     String
  entityType String
  entityId   String?

  result    AuditResult   @default(ALLOW)
  severity  AuditSeverity @default(INFO)
  ip        String?
  userAgent String?
  sessionId String?

  metadata Json?

  /// hash chain (spec §8.5) — hash = SHA256(prevHash + payload)
  prevHash String?
  hash     String

  /// ลำดับต่อเนื่องภายใน tenant — ใช้ไล่ตรวจ chain ให้เร็วและตรวจว่าไม่มีแถวหาย
  seq BigInt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([tenantId, seq])
  @@index([at(sort: Desc)])
  @@index([actorUserId, at(sort: Desc)])
  @@index([entityType, entityId])
  @@index([tenantId, action])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Notification (spec §9.1 · D10) — แจ้งเตือน in-app
//
// ⚠️ `title` กับ `body` เก็บข้อความที่ **ประกอบไว้แล้ว** ไม่ใช่ template ที่รอเติมค่า
// เพราะแถวนี้ต้องอ่านได้โดยไม่ต้องย้อนไปโหลดเอกสาร — และเอกสารอาจถูกปรับชั้นความลับ
// ขึ้นทีหลัง · **ห้ามใส่ชื่อเรื่องของเอกสารชั้น 1-3 ลงมา** (บทเรียน §22.2 — ชื่อเรื่อง
// ของหนังสือลับคือตัวความลับเอง) ตัวประกอบข้อความอยู่ที่ src/lib/notification/
//
// `type` เป็น String ไม่ใช่ enum ตามแบบเดียวกับ AuditLog.action — เพิ่มชนิดใหม่
// ภายหลังจะได้ไม่ต้องมี migration · ฝั่ง TS คุมด้วย NOTIFICATION_TYPES
// ---------------------------------------------------------------------------

model Notification {
  id     String @id @default(uuid(7))
  userId String

  /// ชนิดการแจ้งเตือน เช่น "document.circulated" (ดู src/lib/notification/types.ts)
  type  String
  title String
  body  String

  /// อ้างถึงอะไร — วันนี้มีแค่ "DOCUMENT" แต่เผื่อผูกกับอย่างอื่นได้โดยไม่ต้องแก้ตาราง
  refType String?
  refId   String?

  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// กระดิ่งถามคำถามเดียวเสมอ — "ของฉันที่ยังไม่อ่าน เรียงใหม่ไปเก่า"
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([refType, refId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// SystemSetting (spec §9.1) — ค่าระบบที่ผู้ดูแลแก้ได้จาก /admin/settings
// ---------------------------------------------------------------------------

model SystemSetting {
  tenantId String
  key      String

  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  updatedBy User?  @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@id([tenantId, key])
  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// คำขอสมัครใช้งาน (หน้า /register)
// ไม่สร้าง User จนกว่าผู้ดูแลจะอนุมัติ — กันบัญชีค้างครึ่ง ๆ กลาง ๆ ในระบบ
// ---------------------------------------------------------------------------

model RegistrationRequest {
  id       String @id @default(uuid(7))
  tenantId String

  prefix        String?
  firstName     String
  lastName      String
  email         String
  username      String
  passwordHash  String
  orgUnitId     String
  positionTitle String?
  note          String?

  status       RequestStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?     @db.Timestamptz(3)
  rejectReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orgUnit    OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  reviewedBy User?   @relation("RegistrationReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@map("registration_requests")
}

// ---------------------------------------------------------------------------
// คำขอรีเซ็ตรหัสผ่าน (หน้า /forgot-password)
// MVP ไม่มีอีเมล (D10 — in-app เท่านั้น) คำขอจึงเข้าคิวให้ผู้ดูแลรีเซ็ตให้
// โครงสร้างเก็บ token + TTL ไว้แล้ว เผื่อเปิดใช้ลิงก์ทางอีเมลในอนาคต
// ---------------------------------------------------------------------------

model PasswordResetRequest {
  id     String  @id @default(uuid(7))
  userId String?

  /// อีเมลที่ผู้ใช้กรอก — เก็บไว้แม้หาบัญชีไม่เจอ เพื่อให้ผู้ดูแลตามเรื่องได้
  email String

  status       RequestStatus @default(PENDING)
  resolvedById String?
  resolvedAt   DateTime?     @db.Timestamptz(3)
  note         String?

  ip        String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)

  user       User? @relation("ResetRequestUser", fields: [userId], references: [id], onDelete: Restrict)
  resolvedBy User? @relation("ResetRequestResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([userId])
  @@map("password_reset_requests")
}

// ---------------------------------------------------------------------------
// ฝั่งเอกสาร — P2 Core Documents (spec §6 · §7 · §9.1)
//
// กติกาที่ผูกไว้ในโครงสร้างตั้งแต่ต้น เพราะแก้ทีหลังแล้วทะเบียนย้อนหลังพัง:
//   1. เลขทะเบียนไม่ซ้ำ — @@unique ของ Document ตาม §7.3 คือด่านสุดท้ายที่ฐานข้อมูลบังคับ
//   2. ลบเป็น soft delete เสมอ (deletedAt) และ FK ทุกเส้นเป็น Restrict ตาม §9.3
//   3. เลขที่ยกเลิกไม่ถูกนำกลับมาใช้ซ้ำ — แถวยังอยู่ในทะเบียนพร้อมสถานะ CANCELLED (§6.4)
// ---------------------------------------------------------------------------

/// ทิศทางของหนังสือ (spec §6)
enum DocumentDirection {
  INTERNAL /// บันทึกข้อความภายใน
  OUTGOING /// หนังสือส่งภายนอก
  INCOMING /// หนังสือรับ — โมดูลเบาตาม A1
}

/// สถานะเอกสาร (spec §6.1–6.3)
enum DocumentStatus {
  DRAFT /// ร่าง — แก้ไขได้
  PENDING_NUMBER /// ส่งให้สารบรรณแล้ว รอออกเลข
  RETURNED /// ถูกตีกลับให้แก้ไข (control แทนขั้นอนุมัติ ตาม A2)
  REGISTERED /// ออกเลขแล้ว — ห้ามแก้เลข/วันที่/ชื่อเรื่องอีก
  CIRCULATING /// เวียนถึงผู้รับแล้ว (ภายใน)
  SENT /// ส่งออกภายนอกแล้ว
  RECEIVED /// ลงทะเบียนรับแล้ว (หนังสือรับ)
  FORWARDED /// ส่งต่อให้หน่วยงานที่เกี่ยวข้องแล้ว
  CLOSED /// ปิดเรื่อง
  CANCELLED /// ยกเลิก — เลขที่ออกไปแล้วถูกจองไว้ ไม่นำกลับมาใช้ซ้ำ
}

/// ชั้นของผู้รับในหนังสือเวียน (spec §9.1)
enum RecipientKind {
  TO /// เรียน / ถึง
  CC /// สำเนาถึง
  FYI /// เพื่อทราบ
}

/// สถานะการรับรู้ของผู้รับแต่ละราย
enum RecipientStatus {
  PENDING /// ยังไม่ได้ส่ง
  SENT /// ส่งแล้ว
  READ /// เปิดอ่านแล้ว
  ACKNOWLEDGED /// ตอบรับแล้ว
}

/// การกระทำที่บันทึกลง timeline ของเอกสาร (spec §6.4)
/// คนละชั้นกับ AuditLog — อันนี้ผู้ใช้ทั่วไปเห็น ส่วน audit ไว้ให้ผู้ตรวจสอบ
enum DocumentActionType {
  CREATED
  UPDATED
  SUBMITTED
  RETURNED
  NUMBER_ISSUED
  CIRCULATED
  ACKNOWLEDGED
  MARKED_SENT
  FORWARDED
  CLOSED
  CANCELLED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
}

/// ชนิดของผู้ถือสิทธิ์ใน ACL เฉพาะราย — ต้องตรงกับ AuthzAclEntry ใน src/lib/authz/can.ts
enum AclPrincipalType {
  USER
  ORG_UNIT
  ROLE
}

/// สิทธิ์แบบหยาบใน ACL เฉพาะราย (spec §9.1)
enum AclPermission {
  VIEW
  DOWNLOAD
  EDIT
  MANAGE

  /// นายทะเบียนหนังสือลับ — ออกเลขและเห็นแถวในทะเบียนได้ แต่เปิดไฟล์แนบไม่ได้
  /// ระบบออกให้เองตอนส่งเอกสารลับเข้าคิวออกเลข · ให้ด้วยมือจากหน้าเอกสารไม่ได้
  REGISTER
}

enum AclEffect {
  ALLOW
  DENY
}

/// ประเภทหนังสือ — กำหนด pattern เลขทะเบียนของตัวเองได้ (spec §7.1)
model DocumentType {
  id       String @id @default(uuid(7))
  tenantId String

  code      String
  nameTh    String
  direction DocumentDirection

  /// ทะเบียนที่ใช้แยกเล่ม — เอกสารลับใช้ bookCode แยกจากหนังสือปกติ (spec §7.3)
  defaultBookCode String @default("MAIN")

  /// pattern เฉพาะของประเภทนี้ — ว่างไว้ = ใช้ค่าปริยาย {unitCode}/{seq:4} (D16)
  numberPattern String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documents Document[]

  @@unique([tenantId, code])
  @@index([tenantId, direction, isActive])
  @@map("document_types")
}

/// เอกสารหนึ่งฉบับ (spec §9.1)
model Document {
  id       String @id @default(uuid(7))
  tenantId String

  /// เลขที่หนังสือที่ render จาก pattern แล้ว เช่น "510000/0451"
  /// ว่างจนกว่าจะออกเลข — ร่างยังไม่มีเลข
  docNo String?

  /// ลำดับดิบจาก NumberSequence · แยกเก็บเพราะ docNo เป็นข้อความที่ผ่าน pattern แล้ว
  seqValue Int?
  bookCode String @default("MAIN")

  /// ปีของเลขทะเบียน (พ.ศ.) — ส่วนหนึ่งของคีย์กันเลขซ้ำข้ามปี (§7.2)
  year Int?

  documentTypeId String
  direction      DocumentDirection
  status         DocumentStatus    @default(DRAFT)

  subject String
  summary String?

  docDate      DateTime? @db.Timestamptz(3)
  receivedDate DateTime? @db.Timestamptz(3)
  dueDate      DateTime? @db.Timestamptz(3)

  /// 0 ปกติ · 1 ลับ · 2 ลับมาก · 3 ลับที่สุด (spec §8.1)
  confidentialityLevel Int @default(0)

  /// 0 ปกติ · 1 ด่วน · 2 ด่วนมาก · 3 ด่วนที่สุด
  urgencyLevel Int @default(0)

  /// หน่วยงานเจ้าของเรื่อง — เลขทะเบียนเดินตามหน่วยนี้
  ownerUnitId     String
  createdById     String
  createdByUnitId String

  externalSenderName    String?
  externalRecipientName String?
  refDocNo              String?
  parentDocumentId      String?

  /// เสริมการค้นหาเลขที่/คำอังกฤษ — ภาษาไทยพึ่ง pg_trgm เป็นหลัก (spec §9.2)
  /// Prisma อ่านคอลัมน์ชนิดนี้ไม่ได้ ต้องเขียน/อ่านผ่าน SQL
  searchVector Unsupported("tsvector")?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  ownerUnit      OrgUnit      @relation("DocumentOwnerUnit", fields: [ownerUnitId], references: [id], onDelete: Restrict)
  createdByUnit  OrgUnit      @relation("DocumentCreatedByUnit", fields: [createdByUnitId], references: [id], onDelete: Restrict)
  createdBy      User         @relation("DocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  parentDocument Document?    @relation("DocumentThread", fields: [parentDocumentId], references: [id], onDelete: Restrict)
  childDocuments Document[]   @relation("DocumentThread")

  attachments Attachment[]
  recipients  DocumentRecipient[]
  actions     DocumentAction[]
  acls        DocumentAcl[]

  /// ⚠️ ด่านสุดท้ายของ spec §7.3 — ต่อให้ logic ในแอปพลาด ฐานข้อมูลจะไม่ยอมให้เลขซ้ำ
  /// ร่างที่ยังไม่ออกเลขมี seqValue = NULL ซึ่ง Postgres ไม่ถือว่าชนกัน
  @@unique([tenantId, ownerUnitId, direction, bookCode, year, seqValue])
  @@index([tenantId, ownerUnitId, status, docDate(sort: Desc)])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, docNo])
  @@index([documentTypeId])
  @@index([parentDocumentId])
  /// ⚠️ สาม index ข้างล่างนี้คือหัวใจของการค้นภาษาไทย (§9.2) สร้างมาตั้งแต่ migration ของ P2
  /// ต้องประกาศไว้ที่นี่ด้วย ไม่งั้น `migrate dev` จะเห็นว่าเป็นส่วนเกินที่ไม่มีในแบบ
  /// แล้วใส่ DROP INDEX มาให้ในทุก migration ถัดจากนี้ — ลบไปแล้วการค้นจะยังทำงานถูก
  /// แต่กลายเป็น seq scan ทั้งตาราง ซึ่งเทสต์บนฐานเล็กจับไม่ได้เลย
  @@index([subject(ops: raw("gin_trgm_ops"))], map: "documents_subject_trgm_idx", type: Gin)
  @@index([docNo(ops: raw("gin_trgm_ops"))], map: "documents_docNo_trgm_idx", type: Gin)
  @@index([searchVector], map: "documents_searchVector_idx", type: Gin)
  @@map("documents")
}

/// ตัวนับเลขทะเบียนของแต่ละ (หน่วยงาน × ทิศทาง × เล่ม × ปี) — spec §7.3
model NumberSequence {
  id       String @id @default(uuid(7))
  tenantId String

  orgUnitId String
  direction DocumentDirection
  bookCode  String            @default("MAIN")
  year      Int

  lastValue Int @default(0)

  /// pattern เฉพาะของทะเบียนนี้ — ทับค่าของ DocumentType ได้ (spec §7.1)
  patternOverride String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)

  @@unique([tenantId, orgUnitId, direction, bookCode, year])
  @@map("number_sequences")
}

/// ไฟล์แนบ — เก็บผ่าน StorageAdapter เท่านั้น (D8 · spec §8.2)
model Attachment {
  id         String @id @default(uuid(7))
  documentId String

  /// เอกสารที่ออกเลขแล้วแก้ไม่ได้ แต่แนบไฟล์เวอร์ชันใหม่ได้ (spec §6.4)
  version Int @default(1)

  fileName  String
  mimeType  String
  sizeBytes Int

  /// ตรวจไฟล์ซ้ำและยืนยันความครบถ้วนหลังดาวน์โหลด
  sha256     String
  storageKey String

  /// ฟิลด์เข้ารหัสใช้เมื่อเอกสารเป็นชั้นความลับ (spec §8.2) — ปกติเป็น null
  isEncrypted  Boolean @default(false)
  encAlgo      String?
  encryptedDek String?
  iv           String?
  authTag      String?
  keyVersion   Int?

  uploadedById String
  uploadedAt   DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)

  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  uploadedBy User     @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([documentId, version])
  @@index([sha256])
  @@map("attachments")
}

/// ผู้รับของเอกสารเวียน — เป็นหน่วยงานหรือรายบุคคลอย่างใดอย่างหนึ่ง
/// (CHECK constraint บังคับไว้ในไฟล์ migration)
model DocumentRecipient {
  id         String @id @default(uuid(7))
  documentId String

  orgUnitId String?
  userId    String?

  kind   RecipientKind   @default(TO)
  status RecipientStatus @default(PENDING)

  sentAt         DateTime? @db.Timestamptz(3)
  readAt         DateTime? @db.Timestamptz(3)
  acknowledgedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  orgUnit  OrgUnit? @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([orgUnitId, status])
  @@index([userId, readAt])
  @@map("document_recipients")
}

/// timeline ที่ผู้ใช้เห็นในหน้ารายละเอียดเอกสาร (spec §6.4)
model DocumentAction {
  id         String @id @default(uuid(7))
  documentId String

  actorUserId String?
  actorUnitId String?

  actionType DocumentActionType
  fromStatus DocumentStatus?
  toStatus   DocumentStatus?
  note       String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  document  Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  actorUser User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorUnit OrgUnit? @relation(fields: [actorUnitId], references: [id], onDelete: Restrict)

  @@index([documentId, createdAt])
  @@map("document_actions")
}

/// ACL เฉพาะราย — ด่านที่ 4 ของ can() (spec §4.3 · §9.1)
model DocumentAcl {
  id         String @id @default(uuid(7))
  documentId String

  principalType AclPrincipalType
  principalId   String
  permission    AclPermission
  effect        AclEffect        @default(ALLOW)

  grantedById String
  grantedAt   DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt   DateTime? @db.Timestamptz(3)
  reason      String?

  document  Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  grantedBy User     @relation("DocumentAclGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([documentId, principalType, principalId, permission])
  @@index([documentId])
  @@map("document_acls")
}

/// นายทะเบียนหนังสือลับของหน่วยงานหนึ่ง (ระเบียบว่าด้วยการรักษาความลับของทางราชการ 2544)
///
/// ทำไมต้องมีตารางนี้: §4.3 ข้อ 5 บังคับว่าเอกสารชั้นความลับต้องมี ACL **ระบุตัวบุคคล**
/// เจ้าหน้าที่สารบรรณจึงออกเลขให้เอกสารลับไม่ได้เลยถ้าไม่มีใครออก ACL ให้เขาก่อน
/// การให้ ACL แบบกลุ่ม (ROLE/ORG_UNIT) ใช้แทนไม่ได้เพราะด่านนั้นดูเฉพาะ ACL ที่ระบุตัวคน
///
/// ตั้งได้หลายคนต่อหน่วยงาน — ของจริงต้องมีผู้ช่วยนายทะเบียนไว้ตอนคนหลักลาพักร้อน
/// ไม่งั้นเอกสารลับทั้งหน่วยงานค้างคิวจนกว่าเขาจะกลับมา
model ConfidentialRegistrar {
  id        String @id @default(uuid(7))
  orgUnitId String
  userId    String

  assignedById String
  assignedAt   DateTime @default(now()) @db.Timestamptz(3)

  orgUnit    OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  user       User    @relation("ConfidentialRegistrarUser", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy User    @relation("ConfidentialRegistrarAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([orgUnitId, userId])
  @@index([orgUnitId])
  @@map("confidential_registrars")
}
